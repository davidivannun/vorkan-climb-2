rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(gymId) {
      return signedIn() &&
        get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerId == request.auth.uid;
    }
    match /gyms/{gymId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'city', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /requests/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(gymId));
        allow list: if owner(gymId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['userId', 'status', 'createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if owner(gymId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected'];
        allow delete: if false;
      }

      // Shared published boulders. Any approved member may publish;
      // only the gym owner can alter or remove a published boulder.
      function isMember() {
        return signedIn() &&
          exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid));
      }
      function canAccess() { return owner(gymId) || isMember(); }

      match /blocks/{blockId} {
        allow read: if canAccess();
        allow create: if canAccess()
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'grade', 'kind', 'photoPath', 'marks',
            'authorId', 'authorName', 'createdAt'
          ])
          && request.resource.data.id == blockId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 150
          && request.resource.data.grade is string
          && request.resource.data.kind == 'Bloque'
          && request.resource.data.photoPath is string
          && request.resource.data.marks is list
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if owner(gymId);
      }

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(gymId));
        allow list: if owner(gymId);
        allow create: if owner(gymId)
          && request.resource.data.keys().hasOnly(['userId', 'role', 'joinedAt'])
          && request.resource.data.userId == uid
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/gyms/$(gymId)/requests/$(uid)).data.status == 'approved';
        allow update, delete: if false;
      }
    }
  }
}
