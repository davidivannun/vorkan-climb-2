rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function gym(gymId) {
      return get(/databases/$(database)/documents/gyms/$(gymId));
    }
    function owner(gymId) {
      return signedIn() && gym(gymId).data.ownerId == request.auth.uid;
    }
    function member(gymId) {
      return signedIn() && (owner(gymId) ||
        exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)));
    }
    function admin(gymId) {
      return owner(gymId) || (signedIn() &&
        exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /gyms/{gymId} {
      // Public directory includes only non-sensitive metadata.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'city', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if admin(gymId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /requests/{userId} {
        allow read: if signedIn() &&
          (request.auth.uid == userId || admin(gymId));
        allow create: if signedIn() && request.auth.uid == userId
          && !member(gymId)
          && request.resource.data.keys().hasOnly(['userId', 'status', 'createdAt'])
          && request.resource.data.userId == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if admin(gymId);
      }
      match /members/{userId} {
        allow read: if member(gymId);
        allow create: if admin(gymId)
          && request.resource.data.keys().hasOnly(['userId', 'role', 'joinedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.role in ['member', 'admin']
          && request.resource.data.joinedAt == request.time;
        allow update: if admin(gymId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if admin(gymId) && userId != gym(gymId).data.ownerId;
      }
      match /blocks/{blockId} {
        allow read: if member(gymId);
        allow create: if member(gymId)
          && request.resource.data.keys().hasAll(['authorId', 'photoPath', 'name', 'grade', 'marks', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.photoPath is string
          && request.resource.data.photoPath == 'gyms/' + gymId + '/blocks/' + blockId + '.jpg'
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.grade is string
          && request.resource.data.grade.size() <= 20
          && request.resource.data.marks is list
          && request.resource.data.marks.size() <= 150
          && request.resource.data.createdAt == request.time;
        // Published routes are immutable.
        allow update: if false;
        allow delete: if admin(gymId) ||
          (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }
  }
}
